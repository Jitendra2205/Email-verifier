# Copy to .env and fill in. NEVER commit .env.
PORT=4310

# Auth gate (required). Generate a hash with:  npm run start -- --hash "yourpassword"
AUTH_USER=marketing
AUTH_PASSWORD_HASH=

# 32-byte base64 key for at-rest encryption of uploads/results.
# If omitted, a key is generated into server/data/.datakey on first boot.
DATA_ENCRYPTION_KEY=

# Secret used to sign session cookies. Auto-generated if omitted (sessions drop on restart).
SESSION_SECRET=

# Retention window for jobs and results, in days.
RETENTION_DAYS=7

# SQLite database location (defaults to server/data/verifier.db)
#DB_FILE=

# Verification tuning
# Excel/Word/PDF are parsed in memory, so they get a tighter cap than CSV.
#MAX_BUFFERED_UPLOAD_MB=25

CHUNK_SIZE=1000
DNS_CONCURRENCY=40
DOMAIN_LOOKUPS_PER_MINUTE=20

# SMTP RCPT probing. OFF by default — see README for reputation risk.
SMTP_PROBE_ENABLED=false
SMTP_PROBE_FROM=verify@example.com
SMTP_PROBE_HELO=verifier.example.com
SMTP_PROBES_PER_DOMAIN_PER_MINUTE=3
